# ==============================================================================
# ExamCenter Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Get from: Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT MFA Secret (Generate a strong 32+ character random secret)
JWT_MFA_SECRET=your-super-secret-mfa-jwt-token-key-change-this-in-production

# Resend Email API Configuration for Admin MFA Email OTP
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ExamCenter Security <onboarding@resend.dev>
